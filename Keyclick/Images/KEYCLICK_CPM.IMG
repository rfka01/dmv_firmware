ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее
        jne     timeout
        mov     mode,CMD_ON             ; first patch version: 03h ends
        call    sendcmd                 ; its dispatcher loop
        jc      timeout
        call    waitst
        jc      timeout
        mov     dx,offset msgnolo
        mov     cl,9
        int     0E0h
        jmp     short exit

show:   in      al,KB_STAT
        mov     dx,offset msgoff
        test    al,ST_OFF
        jnz     showit
        mov     dx,offset msglow
        test    al,ST_LOW
        jnz     showit
        mov     dx,offset msgon
showit: mov     cl,9
        int     0E0h
        jmp     short exit

usage:  mov     dx,offset msguse
        mov     cl,9
        int     0E0h
        jmp     short exit

nopatch:
        mov     dx,offset msgnop
        mov     cl,9
        int     0E0h
        jmp     short exit

timeout:
        mov     dx,offset msgtime
        mov     cl,9
        int     0E0h

exit:   mov     cl,0                    ; system reset (no return code
        mov     dl,0                    ; under CP/M-86)
        int     0E0h

;---------------------------------------------------------------------
; skipsp: next character after blanks and tabs -> AL, SI behind it
;---------------------------------------------------------------------
skipsp: lodsb
        cmp     al,' '
        je      skipsp
        cmp     al,9
        je      skipsp
        ret

;---------------------------------------------------------------------
; sendcmd: write command 'mode' to the 8741 as soon as its input
; buffer is empty. The final test and the OUT run with interrupts off
; so that the BIOS cannot write to the 8741 in between.
; The 8741 may be busy for up to about 0.6 s (bell), so wait long.
; Out: CF set on timeout.
;---------------------------------------------------------------------
sendcmd:
        mov     bx,20                   ; about 20 x 65536 polls
        xor     cx,cx
sc_wait:
        in      al,KB_STAT
        test    al,ST_IBF
        jnz     sc_next
        pushf
        cli
        in      al,KB_STAT
        test    al,ST_IBF
        jnz     sc_busy
        mov     al,mode
        out     KB_STAT,al
        popf
        clc
        ret
sc_busy:
        popf
sc_next:
        loop    sc_wait
        dec     bx
        jnz     sc_wait
        stc
        ret

;---------------------------------------------------------------------
; waitst: wait until status bits 5/4 match 'mode'.
; Out: CF set on timeout.
;---------------------------------------------------------------------
waitst: mov     ah,0                    ; expected bits 5/4
        cmp     mode,CMD_OFF
        jne     ws_low
        mov     ah,ST_OFF
ws_low: cmp     mode,CMD_LOW
        jne     ws_go
        mov     ah,ST_LOW
ws_go:  mov     bx,20
        xor     cx,cx
ws_loop:
        in      al,KB_STAT
        and     al,ST_MODE
        cmp     al,ah
        je      ws_ok
        loop    ws_loop
        dec     bx
        jnz     ws_loop
        stc
        ret
ws_ok:  clc
        ret

CSEG    ENDS
        END     START
