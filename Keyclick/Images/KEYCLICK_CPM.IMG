; 256 zero bytes for the base page (MKCMD.PY does this).
;=====================================================================

KB_STAT EQU     41h             ; 8741 status (read) / command (write)
ST_IBF  EQU     02h             ; input buffer full
ST_LOW  EQU     10h             ; tick (LOW)
ST_OFF  EQU     20h             ; key click off
ST_MODE EQU     30h
ST_PATCH EQU    40h             ; key click patch present
CMD_OFF EQU     02h
CMD_ON  EQU     03h
CMD_LOW EQU     04h

CSEG    SEGMENT PARA PUBLIC 'CODE'
        ASSUME  CS:CSEG,DS:CSEG,ES:CSEG,SS:CSEG
        ORG     100h

START:  jmp     main

;=====================================================================
;  Data
;=====================================================================

mode    db      0                       ; 0 show, CMD_OFF, CMD_ON, CMD_LOW
param   db      4 dup (0)               ; parameter, upper case

keytab  db      'ON',0,0,  CMD_ON
        db      'OFF',0,   CMD_OFF
        db      'LOW',0,   CMD_LOW
        db      0

msgon   db      'Tastaturklick ist AN',13,10,'$'
msgoff  db      'Tastaturklick ist AUS',13,10,'$'
msglow  db      'Tastaturklick ist LOW',13,10,'$'
msgnolo db      'Diese Version des Klick-Patches kennt LOW noch nicht.',13,10
        db      'Der Klick bleibt AN. Bitte das neue ROM einsetzen.',13,10,'$'
msgnop  db      'Der Tastatur-Controller (8741 auf der Hauptplatine) hat die',13,10
        db      'Originalfirmware ohne Klick-Schalter. KEYCLICK braucht das',13,10
        db      'gepatchte ROM 32678 (DMV_MB_8741_32678_KEYCLICK.BIN).',13,10,'$'
msgtime db      'Der Tastatur-Controller antwortet nicht.',13,10,'$'
msguse  db      'KEYCLICK - Tastaturklick der NCR Decision Mate V',13,10
        db      13,10
        db      '  KEYCLICK        zeigt die Einstellung',13,10
        db      '  KEYCLICK ON     Tastaturklick an',13,10
        db      '  KEYCLICK OFF    Tastaturklick aus',13,10
        db      '  KEYCLICK LOW    nur ein leiser Knack',13,10
        db      13,10
        db      'Nach jedem Reset ist der Klick wieder an.',13,10,'$'

;=====================================================================
;  Code
;=====================================================================

main:   cld
        mov     bl,ds:[80h]             ; the CP/M tail has no CR:
        xor     bh,bh                   ; end it with one
        mov     byte ptr [bx+81h],13
        mov     si,81h                  ; command tail
        call    skipsp
        cmp     al,13
        je      check                   ; no parameter: show
        mov     di,offset param         ; copy up to 4 characters
        mov     cx,4
cpy:    cmp     al,' '
        je      cpyend
        cmp     al,9
        je      cpyend
        cmp     al,13
        je      cpyend
        test    cx,cx
        jnz     cpyok
        jmp     usage                   ; word too long
cpyok:
        cmp     al,'a'
        jb      cpyup
        cmp     al,'z'
        ja      cpyup
        sub     al,20h
cpyup:  stosb
        dec     cx
        lodsb
        jmp     cpy
cpyend: dec     si                      ; nothing may follow
        call    skipsp
        cmp     al,13
        jne     usage
        mov     bx,offset keytab        ; look the word up
look:   cmp     byte ptr [bx],0
        je      usage
        mov     ax,word ptr [bx]
        cmp     ax,word ptr param
        jne     lnext
        mov     ax,word ptr [bx+2]
        cmp     ax,word ptr param+2
        jne     lnext
        mov     al,[bx+4]
        mov     mode,al
        jmp     short check
lnext:  add     bx,5
        jmp     look

check:  in      al,KB_STAT
        test    al,ST_PATCH
        jz      nopatch
        cmp     mode,0
        je      show

        call    sendcmd                 ; CF = timeout
        jc      timeout
        call    waitst                  ; wait until the status shows it
        jnc     show
        cmp     mode,CMD_LOWееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее